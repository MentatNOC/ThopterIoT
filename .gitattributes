# Normalize line endings: store LF in the repo, check out native on each platform.
* text=auto

# Windows-native tooling keeps CRLF in the working tree.
*.sln    text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.ps1    text eol=crlf

# Shell scripts and CI must stay LF even on Windows checkouts.
*.sh  text eol=lf
*.yml text eol=lf

# The embedded IEEE OUI dataset is generated; treat as text but don't diff-spam it.
src/Thopter.Discovery/Oui/oui.tsv text eol=lf linguist-generated=true
