<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Thopter.App</RootNamespace>
    <AssemblyName>Thopter.App</AssemblyName>

    <!-- Avalonia: compiled bindings only. x:DataType is set on every view; reflection
         bindings fail silently under NativeAOT so this is not optional. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- No admin: sockets + NIC enumeration + light identify need no elevation. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Wing-X brand icon: Explorer/shortcut icon baked into the exe; the window icon
         loads the same file as an Avalonia resource. Regenerate via tools/wings. -->
    <ApplicationIcon>Assets\thopter.ico</ApplicationIcon>

    <!-- Publish is single-file self-contained (see the RID-scoped group below), NOT NativeAOT.
         AOT emits Skia/HarfBuzz/GL as loose native DLLs that a lone-exe download can't carry, so
         the released exe crashed in SkiaPlatform.Initialize with no window; the self-extracting
         single file embeds them instead. The AOT/trim/single-file analyzers stay on so the code
         stays AOT-ready and returning to an AOT + zip release is a small change. InvariantGlobalization
         drops ICU for a smaller build. -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Description>ThopterIoT desktop GUI - local-network IoT/IP-camera discovery scanner (free, open-core front end for MentatNOC).</Description>
  </PropertyGroup>

  <!-- Avalonia's assemblies are not fully trim-annotated, so the AOT compiler (ILC) rolls
       up IL2026/IL2104/IL3053 warnings for them, and warnings-as-errors would fail the
       publish. ILC only runs when publishing for a concrete runtime, so scoping the NoWarn
       to a set RuntimeIdentifier keeps the strict build-time trim/AOT analyzers on our own
       code (plain build and test carry no RID) while letting the AOT publish through.
       Avalonia supports NativeAOT with compiled bindings, which this project mandates. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <NoWarn>$(NoWarn);IL2026;IL2104;IL3053</NoWarn>

    <!-- One self-contained file that runs with no install and no .NET runtime on the box. The
         native libs (libSkiaSharp, libHarfBuzzSharp, av_libglesv2) are embedded and self-extract
         on first run; without IncludeNativeLibrariesForSelfExtract they ship loose and the lone
         exe breaks exactly as the first release did. Untrimmed, so no Avalonia XAML/reflection
         path is stripped; compression keeps the single file's download size down. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- MentatNOC brand font (Martian Mono, SIL OFL) embedded for a driverless single-file app. -->
    <AvaloniaResource Include="Assets\Fonts\MartianMono-Variable.ttf" />
    <!-- Scan-in-progress wing-flutter sprite frames (8-bit ornithopter wings). -->
    <AvaloniaResource Include="Assets\Wings\*.png" />
    <AvaloniaResource Include="Assets\thopter.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Avalonia XAML diagnostics overlay (Alt+Shift+F12) - Debug-only, not shipped in Release. -->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.1.5" />
    <!-- Security: override Avalonia's transitive Tmds.DBus.Protocol (0.16.0, GHSA-xrw6-gwf8-vvr9)
         with a patched build. It's Linux D-Bus support only and never loads on Windows, but we
         don't ship a known-vulnerable package. Remove if/when Avalonia bumps it upstream. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thopter.Discovery\Thopter.Discovery.csproj" />
    <ProjectReference Include="..\Thopter.Cloud.Abstractions\Thopter.Cloud.Abstractions.csproj" />
  </ItemGroup>

</Project>
