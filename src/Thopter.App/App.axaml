<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Thopter.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Theme-independent brand tokens -->
            <FontFamily x:Key="BrandFont">avares://Thopter.App/Assets/Fonts/MartianMono-Variable.ttf#Martian Mono</FontFamily>
            <Color x:Key="SaphoColor">#C2342B</Color>

            <!-- Drive the Fluent accent (buttons, focus ring, selection, progress) from sapho red. -->
            <Color x:Key="SystemAccentColor">#C2342B</Color>
            <Color x:Key="SystemAccentColorDark1">#B02E26</Color>
            <Color x:Key="SystemAccentColorDark2">#9A2820</Color>
            <Color x:Key="SystemAccentColorDark3">#84221B</Color>
            <Color x:Key="SystemAccentColorLight1">#CE4A41</Color>
            <Color x:Key="SystemAccentColorLight2">#D96259</Color>
            <Color x:Key="SystemAccentColorLight3">#E37B72</Color>

            <ResourceDictionary.ThemeDictionaries>
                <!-- DARK: near-black ground, off-white ink, sapho red punctuation -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="InkBrush" Color="#0E0E10" />
                    <SolidColorBrush x:Key="InkRaiseBrush" Color="#17171A" />
                    <SolidColorBrush x:Key="BoneBrush" Color="#F4F1EA" />
                    <SolidColorBrush x:Key="MuteBrush" Color="#ADABA4" />
                    <SolidColorBrush x:Key="SaphoBrush" Color="#D8453B" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#F4F1EA" Opacity="0.12" />
                    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#F4F1EA" Opacity="0.26" />
                    <SolidColorBrush x:Key="DetailCardBrush" Color="#17171A" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#F4F1EA" Opacity="0.13" />
                    <SolidColorBrush x:Key="OnvifTintBrush" Color="#D8453B" Opacity="0.12" />
                </ResourceDictionary>

                <!-- LIGHT: bone ground, near-black ink, same sapho red -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InkBrush" Color="#F1EEE6" />
                    <SolidColorBrush x:Key="InkRaiseBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BoneBrush" Color="#1A1A1F" />
                    <SolidColorBrush x:Key="MuteBrush" Color="#57544D" />
                    <SolidColorBrush x:Key="SaphoBrush" Color="#B22C24" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#1A1A1F" Opacity="0.12" />
                    <SolidColorBrush x:Key="HairlineStrongBrush" Color="#1A1A1F" Opacity="0.24" />
                    <SolidColorBrush x:Key="DetailCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#1A1A1F" Opacity="0.09" />
                    <SolidColorBrush x:Key="OnvifTintBrush" Color="#B22C24" Opacity="0.09" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

</Application>
